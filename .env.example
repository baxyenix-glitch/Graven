# ==============================================================================
# GRAVEN v3 ENVIRONMENT CONFIGURATION
# ==============================================================================

# Network Mode: 'mainnet' or 'testnet'
NEXT_PUBLIC_NETWORK_MODE=mainnet
TESTNET_DEV_MODE=false

# Privy Authentication & Embedded Wallets
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_SERVER_WALLET_ID=your_privy_server_wallet_id
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Mobile Deep Linking (WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Robinhood Chain Mainnet
RH_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_EXPLORER_URL=https://robinhoodchain.blockscout.com
RH_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api

# Graven Protocol Token ($GRAVEN contract address to be provided after launch)
GRAVEN_TOKEN_ADDRESS=
NEXT_PUBLIC_GRAVEN_TOKEN_ADDRESS=
MIN_GRAVEN_HOLD=10000

# Pons Launchpad (pons.family) contracts
PONS_FACTORY_ADDRESS=
PONS_BONDING_CURVE_ROUTER=
PONS_METADATA_API_URL=https://api.pons.family

# Platform Security & Administration
ADMIN_WALLETS=
CRON_SECRET=graven_super_secure_cron_secret_v3
DEV_ALLOWED_ORIGINS=localhost:3000,127.0.0.1:3000

# Rewards & Views Economics
REWARD_DEV_PCT=60
REWARD_HOLDERS_PCT=30
REWARD_PLATFORM_PCT=10
REWARD_ETH_PER_QUALIFIED_VIEW=0.0005
DAILY_CAP_PER_WALLET_ETH=0.05
DAILY_CAP_PER_GRAVE_ETH=0.25
DAILY_CAP_GLOBAL_ETH=2.0
MIN_CLAIM_THRESHOLD_ETH=0.001

# Dead Coin Thresholds
DEAD_MIN_DAYS=7
DEAD_MCAP_DROP_PCT=85

# Social Links (Leave unset or empty to hide in UI)
NEXT_PUBLIC_TWITTER_URL=https://x.com/GravendotFun
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
